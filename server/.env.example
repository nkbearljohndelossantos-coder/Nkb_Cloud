# =============================================================================
# NKB Cloud Server Environment Configuration Template
# =============================================================================
PORT=5000
NODE_ENV=production

# JWT Authentication
# MANDATORY: Must be at least 32 characters long.
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_SECURE_GENERATED_64_CHAR_HEX_KEY
JWT_EXPIRES_IN=7d

# PostgreSQL Connection (Hostinger AlmaLinux 10 VPS)
# When set, the system connects to PostgreSQL 16; if omitted locally, embedded engine is used.
DATABASE_URL=postgres://nkb_app:REPLACE_WITH_APP_PASSWORD@localhost:5432/nkb_cloud
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=nkb_app
# PGPASSWORD=REPLACE_WITH_APP_PASSWORD
# PGDATABASE=nkb_cloud

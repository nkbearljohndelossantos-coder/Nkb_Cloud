# NKB Cloud Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=nkb-enterprise-cloud-ultra-secure-key-2026-production
JWT_EXPIRES_IN=7d

# PostgreSQL Connection (AlmaLinux 10 Hostinger VPS)
# When set, the system automatically uses PostgreSQL; if omitted locally, embedded engine is used.
DATABASE_URL=postgres://nkb_user:StrongPassword2026!@localhost:5432/nkb_cloud
# PGHOST=localhost
# PGPORT=5432
# PGUSER=nkb_user
# PGPASSWORD=StrongPassword2026!
# PGDATABASE=nkb_cloud

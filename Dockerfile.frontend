# ==============================================================================
# NKB Cloud v2.1.0 — Frontend Multi-Stage Dockerfile
# Production-ready, non-root Nginx static asset server
# Build Runtime: Node.js 26 Active LTS (v26.13.0 on Alpine Linux 3.24)
# Web Server: Nginx 1.26.3 Stable (Alpine Linux 3.20)
# ==============================================================================

# Stage 1: Build the React + Vite static bundle
FROM node:26.13.0-alpine AS builder

WORKDIR /app

# Copy dependency specifications
COPY client/package.json client/package-lock.json ./

# Install exact dependencies
RUN npm ci

# Copy client source code
COPY client/ ./

# Compile production bundle
RUN npm run build

# Stage 2: Serve static files with Nginx Stable
FROM nginx:1.26.3-alpine@sha256:1eadbb07820339e8bbfed18c771691970baee292ec4ab2558f1453d26153e22d

# Remove default nginx welcome page
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Copy custom frontend internal configuration
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

# Copy compiled production bundle from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose internal port
EXPOSE 80

# Signal configuration
STOPSIGNAL SIGQUIT

# Run Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]

# ==============================================================================
# NKB CLOUD v2.1.0 — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Target Platform: AlmaLinux 10 Hostinger VPS (Docker Compose Deployment)
#
# IMPORTANT: Copy this file to .env.production on the VPS.
# NEVER commit the real .env.production file to any Git repository!
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Platform Branding & Domain
APP_DOMAIN=cloud.nkb.local
APP_NAME="NKB Cloud"

# PostgreSQL 16 Enterprise Database Configuration
# (Internal container network hostname: 'db', internal port: 5432)
POSTGRES_DB=nkb_cloud_production
POSTGRES_USER=nkb_prod_admin
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_RANDOM_PASSWORD_32_CHARS_MIN

# Database Connection URI (Used by Express Backend)
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
PGHOST=db
PGPORT=5432
PGUSER=${POSTGRES_USER}
PGPASSWORD=${POSTGRES_PASSWORD}
PGDATABASE=${POSTGRES_DB}

# JWT Authentication Security
# Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_HEX_64_CHAR_CRYPTOGRAPHIC_SECRET_KEY
JWT_EXPIRES_IN=7d

# Universal Maintenance Gate
# Set to 'true' during database migrations, server upgrades, or security audits.
# Set to 'false' for normal multi-user enterprise operations.
STAGING_MAINTENANCE_GATE=false

# In-Container Application Directories (Mounted to persistent Docker named volumes)
STORAGE_ROOT=/app/storage
UPLOAD_TEMP_DIR=/app/uploads
DOWNLOAD_TEMP_DIR=/app/downloads
LOGS_DIR=/app/logs

# Storage Agent Mutual Authentication & Command Envelope Signing (Ed25519)
# Generate with: node -e "const crypto = require('crypto'); const { publicKey, privateKey } = crypto.generateKeyPairSync('ed25519'); console.log('PUB:', publicKey.export({type:'spki',format:'pem'})); console.log('PRIV:', privateKey.export({type:'pkcs8',format:'pem'}));"
SERVER_ED25519_PUBLIC_KEY="REPLACE_WITH_BASE64_ED25519_SERVER_PUBLIC_KEY"
SERVER_ED25519_PRIVATE_KEY="REPLACE_WITH_BASE64_ED25519_SERVER_PRIVATE_KEY"

# Storage Agent Security Parameters
AGENT_COMMAND_TTL_MS=60000
AGENT_NONCE_TTL_SECONDS=300
REQUIRE_TLS13=true
ALLOWLIST_STRICT_MODE=true

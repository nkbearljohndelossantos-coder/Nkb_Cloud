# ==============================================================================
# NKB Cloud v2.1.0 — Backend Dockerfile
# Production-hardened, unprivileged container with dumb-init
# Node.js Runtime: Node.js 26 Active LTS (v26.13.0 on Alpine Linux 3.24)
# ==============================================================================

FROM node:26.13.0-alpine

# Set working directory
WORKDIR /app

# Install dumb-init for robust signal handling and PID 1 process supervision
RUN apk add --no-cache dumb-init

# Set production environment defaults
ENV NODE_ENV=production \
    PORT=5000 \
    HOST=0.0.0.0

# Copy dependency manifests
COPY server/package.json server/package-lock.json ./

# Install production dependencies strictly from lockfile
RUN npm ci --omit=dev

# Copy server application source code
COPY server/ ./

# Create operational directories and set ownership to built-in unprivileged 'node' user (UID 1000)
RUN mkdir -p /app/storage /app/uploads /app/downloads /app/logs && \
    chown -R node:node /app

# Switch to non-root user
USER node

# Expose backend API and WebSocket port
EXPOSE 5000

# Container Healthcheck probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:5000/health || exit 1

# Process management entrypoint
ENTRYPOINT ["dumb-init", "--"]

# Default start command
CMD ["node", "server.js"]

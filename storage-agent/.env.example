# NKB Cloud Storage Agent Configuration
# Organization: NKB Manufacturing

# Point to your VPS domain or IP (WebSocket endpoint)
NKB_SERVER_URL=ws://localhost:5000/ws/agent
# For Production VPS:
# NKB_SERVER_URL=wss://cloud.nkbmanufacturing.com/ws/agent

# Agent pairing security token (Generated from Web App Admin -> Storage Agents)
NKB_AGENT_TOKEN=nkb_agent_token_primary_2026

# Friendly Identifier for this Windows computer
NKB_AGENT_NAME=NKB-STORAGE-PC-01
